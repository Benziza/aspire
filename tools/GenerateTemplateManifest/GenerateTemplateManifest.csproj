<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Use the same template engine as the SDK that performs restore, without installing templates
       into the user's hive or maintaining another template-engine package version. -->
  <ItemGroup>
    <Reference Include="$(MSBuildBinPath)\Microsoft.TemplateEngine.Abstractions.dll" />
    <Reference Include="$(MSBuildBinPath)\Microsoft.TemplateEngine.Core.Contracts.dll" />
    <Reference Include="$(MSBuildBinPath)\Microsoft.TemplateEngine.Core.dll" />
    <Reference Include="$(MSBuildBinPath)\Microsoft.TemplateEngine.Edge.dll" />
    <Reference Include="$(MSBuildBinPath)\Microsoft.TemplateEngine.Orchestrator.RunnableProjects.dll" />
    <Reference Include="$(MSBuildBinPath)\Microsoft.TemplateEngine.Utils.dll" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Reference Include="$(MSBuildBinPath)\Newtonsoft.Json.dll" />
    <Reference Include="$(MSBuildBinPath)\NuGet.*.dll" />
    <InternalsVisibleTo Include="Infrastructure.Tests" />
  </ItemGroup>
</Project>
