@using Aspire.Dashboard.Resources
@inject IStringLocalizer<Layout> Loc
@inject IStringLocalizer<Aspire.Dashboard.Resources.StructuredLogs> StructuredLogsLoc
@inject IDashboardClient DashboardClient

<nav class="header-nav" aria-label="@Loc[nameof(Layout.NavMenuLandmark)]">
    @foreach (var item in GetItems())
    {
        var isActive = item.Section == _activeSection;
        <a href="@item.Href"
           class="header-nav-item @(isActive ? "active" : null)"
           aria-current="@(isActive ? "page" : null)">
            <FluentIcon Value="@(isActive ? item.ActiveIcon : item.Icon)" Width="20px" Color="Color.Custom" CustomColor="currentColor" />
            <span class="header-nav-text">@item.Text</span>
        </a>
    }
</nav>
